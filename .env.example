# ────────────────────────────────────────────────────────────────
#  Скопируйте в .env и поправьте под себя:  cp .env.example .env
# ────────────────────────────────────────────────────────────────

# Токен Hugging Face. Нужен ОДИН раз — для scripts/prefetch_models.py,
# т.к. модели pyannote gated (надо принять лицензию на сайте).
# После скачивания весов в ./models токен больше не используется.
HF_TOKEN=

# ─── ASR ────────────────────────────────────────────────────────
# Модель для batch-обработки (эталонное качество)
BATCH_ASR_MODEL=large-v3
# Модель для live-режима (компромисс качество/задержка)
LIVE_ASR_MODEL=large-v3-turbo
# Язык по умолчанию: ru | en | auto
DEFAULT_LANGUAGE=ru

# ВАЖНО: на RTX 50xx (Blackwell, sm_120) int8 в CTranslate2 падает
# с CUBLAS_STATUS_NOT_SUPPORTED. Не меняйте на int8_float16 без проверки.
COMPUTE_TYPE=float16

# ─── Диаризация ─────────────────────────────────────────────────
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Движок live-диаризации: sortformer | none. diart — только в образе,
# собранном с ним (в штатном его нет: numpy ниже 2 против NeMo 3).
LIVE_DIARIZATION=sortformer
# Ожидаемое число говорящих (0 = определять автоматически)
NUM_SPEAKERS=0

# Отсекать тишину до распознавания. По умолчанию выключено: на записях,
# где под речью есть музыка или шум (фильм, созвон, комната), фильтр
# принимает такие куски за тишину и молча выбрасывает больше половины
# слов. Включайте только для заведомо чистых записей с долгими паузами.
VAD_FILTER=false

# То же для живого режима. Здесь фильтр оставлен включённым: в стриминге
# он держит задержку, а черновик всё равно уточняется полной обработкой.
# Если живой текст теряет слова — поставьте false.
LIVE_VAD=true

# Выбрасывать из чистовика строчки из титров, которые Whisper выдумывает на
# музыке и тишине («Субтитры сделал DimaTorzok», «Продолжение следует...»
# целой фразой). Живой черновик чистится всегда. Настоящую речь фильтр не
# трогает — см. tests/test_hallucinations.py.
# DROP_HALLUCINATIONS=true

# Живая диаризация (Streaming Sortformer). Значения подобраны замером
# (bench/eval_live.py) и уже стоят по умолчанию — раскомментируйте,
# только чтобы поменять.
# Задержка разметки, с: 0.32 или 1.04 — второе чуть точнее, но слово
# получает говорящего на 0,7 с позже.
# LIVE_SORTFORMER_LATENCY=0.32
# LIVE_SORTFORMER_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1

# Правила живого черновика — от движка не зависят.
# Реплика короче стольких слов не может сменить говорящего — остаётся у
# предыдущего. Убирает дрожь меток на стыке реплик. 1 — выключить.
# LIVE_MIN_TURN_WORDS=4
# Граница говорящих посреди предложения переносится к его концу, если он
# не дальше стольких слов. 0 — выключить.
# LIVE_SNAP_WORDS=1

# Только для diart (если соберёте образ с ним): задержка разметки, с, и
# пороги кластеризации.
# LIVE_DIAR_LATENCY=0.5
# LIVE_DIAR_RHO_UPDATE=0.1
# LIVE_DIAR_TAU_ACTIVE=0.6
# LIVE_DIAR_DELTA_NEW=1.0

# Обработка микрофона средствами браузера: подавление эха, шумоподавление,
# автогромкость. Выключена: это инструменты для звонков, и они вырезают
# как раз то, что нужно расшифровать, — звук из колонок и тихие реплики.
MIC_PROCESSING=false

# Затравка для модели: имена участников, термины, названия. Сильнее всего
# влияет на имена собственные. Пример:
# INITIAL_PROMPT=Совещание команды. Участники: Антон, Ольга, Сергей.
INITIAL_PROMPT=
MAX_SPEAKERS=8

# ─── Ресурсы ────────────────────────────────────────────────────
# Одновременных live-сессий (упирается в VRAM)
MAX_LIVE_SESSIONS=2
# Автоматически переобрабатывать live-запись batch-пайплайном после «Стоп»
AUTO_REFINE_LIVE=true

# ─── Сеть ───────────────────────────────────────────────────────
# Имя/адрес, по которому сервис открывают другие машины в локальной сети.
# Должно совпадать с тем, на что выписан сертификат mkcert.
LAN_HOST=scribe.local
HTTPS_PORT=443
HTTP_PORT=80

# ─── Прочее ─────────────────────────────────────────────────────
# Полный оффлайн: запретить любые обращения к huggingface.co
HF_HUB_OFFLINE=1
LOG_LEVEL=INFO
# Автоудаление аудио старше N дней (0 = не удалять)
RETENTION_DAYS=0
